[Unit]
Description=Eunwol Launcher Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/eunwol/repo/backend
ExecStart=/usr/bin/node --env-file=/opt/eunwol/repo/backend/.env /opt/eunwol/repo/backend/src/server.js
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/eunwol

[Install]
WantedBy=multi-user.target
