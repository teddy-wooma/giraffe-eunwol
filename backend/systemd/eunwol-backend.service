[Unit]
Description=Eunwol Launcher Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eunwol
Group=eunwol
WorkingDirectory=/opt/eunwol-backend
ExecStart=/usr/bin/node --env-file=/opt/eunwol-backend/.env /opt/eunwol-backend/src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/eunwol

[Install]
WantedBy=multi-user.target
