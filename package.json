{
  "name": "eunwol-launcher",
  "version": "1.0.0",
  "productName": "은월 런처",
  "description": "은월 런처 - 마인크래프트 26.2 (Fabric) 실행기",
  "author": "Eunwol",
  "license": "UNLICENSED",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node tools/start.cjs",
    "start:no-sandbox": "node tools/start.cjs --no-sandbox",
    "distro:build": "node tools/build-distribution.cjs",
    "distro:verify": "node tools/verify-distribution.cjs",
    "branding": "python tools/make-branding.py",
    "dist": "electron-builder build",
    "dist:win": "npm run dist -- -w",
    "dist:mac": "npm run dist -- -m",
    "dist:linux": "npm run dist -- -l",
    "lint": "eslint .",
    "check": "electron tools/check-electron.cjs",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "adm-zip": "^0.5.16",
    "discord-rpc-patch": "^4.0.1",
    "ejs": "^3.1.10",
    "ejs-electron": "^3.0.0",
    "electron-updater": "^6.7.3",
    "fs-extra": "^11.3.3",
    "github-syntax-dark": "^0.5.0",
    "got": "^11.8.5",
    "helios-core": "~2.3.0",
    "helios-distribution-types": "^1.3.0",
    "jquery": "^3.7.1",
    "js-yaml": "^4.3.2",
    "lodash.merge": "^4.6.2",
    "semver": "^7.7.3",
    "toml": "^3.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.2"
  }
}
